{
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.financeospro.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/sw.js",
      "destination": "/app/sw.js"
    },
    {
      "source": "/app/workbox-:hash.js",
      "destination": "/app/workbox-:hash.js"
    },
    {
      "source": "/app/((?!assets|favicon|icon|manifest|sw|workbox|apple-touch).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript" }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
